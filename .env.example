# Copy to .env for local `npm run dev` runs. Leave blank to force offline QR mode.
# Cloudflare Pages Build ENV에 동일 이름으로 넣어두면 프로덕션에도 반영됩니다.

# Signaling Worker base URL (예: https://minidamo-signaling.your-subdomain.workers.dev)
VITE_SIGNALING_URL=

# Optional TURN relay (Cloudflare Realtime TURN, coturn 등)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
